Does booking too far in advance increase the likelihood of a cancellation? Should we adjust our non-refundable policy for long lead times?

SELECT 
    CASE 
        WHEN lead_time <= 7 THEN '0-7 Days (Last Minute)'
        WHEN lead_time BETWEEN 8 AND 30 THEN '8-30 Days'
        WHEN lead_time BETWEEN 31 AND 90 THEN '31-90 Days'
        WHEN lead_time BETWEEN 91 AND 180 THEN '91-180 Days'
        ELSE '180+ Days (Far Advance)'
    END AS lead_time_bucket,
    COUNT(*) AS total_bookings,
    ROUND(100.0 * SUM(is_canceled) / COUNT(*), 2) || '%' AS cancellation_rate
FROM hotelbook
GROUP BY lead_time_bucket
ORDER BY MIN(lead_time);

Which months bring in the highest revenue and occupancy so we can optimize seasonal pricing and staffing levels?

SELECT 
    arrival_date_year,
    arrival_date_month,
    COUNT(*) AS total_bookings,
    ROUND(SUM(adr * (stays_in_weekend_nights + stays_in_week_nights)), 2) AS total_revenue,
    ROUND(AVG(adr), 2) AS avg_adr
FROM hotelbook
WHERE is_canceled = 0
GROUP BY arrival_date_year, arrival_date_month
ORDER BY arrival_date_year, total_revenue DESC;

Are non-refundable deposits actually reducing cancellations compared to flexible options?

SELECT 
    deposit_type,
    COUNT(*) AS total_bookings,
    SUM(is_canceled) AS cancellations,
    ROUND(100.0 * SUM(is_canceled) / COUNT(*), 2) || '%' AS cancellation_rate
FROM hotelbook
GROUP BY deposit_type;

What percentage of our bookings include children, and do families spend more per night than adults traveling without kids?

SELECT 
    CASE 
        WHEN (CAST(children AS INTEGER) + babies) > 0 THEN 'Family (With Kids)'
        WHEN adults > 1 THEN 'Couples / Groups'
        ELSE 'Solo Traveler'
    END AS guest_category,
    COUNT(*) AS total_bookings,
    ROUND(AVG(adr), 2) AS avg_daily_rate,
    ROUND(AVG(stays_in_weekend_nights + stays_in_week_nights), 2) AS avg_length_of_stay
FROM hotelbook
WHERE is_canceled = 0
GROUP BY guest_category;

How often are guests assigned a different room type than what they reserved, and does this impact cancellation or satisfaction?

SELECT 
    reserved_room_type,
    assigned_room_type,
    CASE 
        WHEN reserved_room_type = assigned_room_type THEN 'As Reserved'
        ELSE 'Reassigned / Upgraded'
    END AS assignment_status,
    COUNT(*) AS total_bookings,
    ROUND(AVG(adr), 2) AS avg_adr
FROM hotelbook
WHERE is_canceled = 0
GROUP BY assignment_status;

Do guests who make special requests or ask for parking spaces cancel less often?

SELECT 
    total_of_special_requests,
    COUNT(*) AS total_bookings,
    ROUND(100.0 * SUM(is_canceled) / COUNT(*), 2) || '%' AS cancellation_rate,
    ROUND(AVG(adr), 2) AS avg_adr
FROM hotelbook
GROUP BY total_of_special_requests
ORDER BY total_of_special_requests;
